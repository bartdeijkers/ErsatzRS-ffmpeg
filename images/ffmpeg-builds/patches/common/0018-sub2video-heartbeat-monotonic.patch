--- a/fftools/ffmpeg_filter.c
+++ b/fftools/ffmpeg_filter.c
@@ -330,7 +330,11 @@
     int ret;
 
     av_assert1(frame->data[0]);
-    ifp->sub2video.last_pts = frame->pts = pts;
+    /* A subpicture can start behind the latest heartbeat. Do not move last_pts
+       back, or every heartbeat up to the old value (one per audio packet) pushes
+       the canvas again. Push it at last_pts instead: at its own pts it can fall
+       before an input trim (-ss) and be dropped. */
+    ifp->sub2video.last_pts = frame->pts = FFMAX(ifp->sub2video.last_pts, pts);
     ret = av_buffersrc_add_frame_flags(ifp->ifilter.filter, frame,
                                        AV_BUFFERSRC_FLAG_KEEP_REF |
                                        AV_BUFFERSRC_FLAG_PUSH);
